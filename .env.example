# .env.example — variabili d'ambiente del sito marketing Locario

# GA4 (facoltativa): se assente, GA4 e il banner cookie restano disattivati.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_SITE_URL="https://locario.net"
RESEND_API_KEY=""
CONTACT_FROM_EMAIL="Locario <noreply@locario.net>"
CONTACT_TO_EMAIL="reservation@locario.net"

# Collegamento protetto al checkout del SaaS Locario
LOCARIO_SAAS_URL="https://app.locario.net"
SAAS_CHECKOUT_SECRET=""
# Anti-bot Cloudflare Turnstile: stessa chiave del sito del SaaS (il dominio locario.net va abilitato nel widget)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""

# Dati dell'azienda mostrati in Privacy e Termini (compilare con i dati reali: ragione sociale, sede, P. IVA)
NEXT_PUBLIC_LEGAL_NAME=""
NEXT_PUBLIC_LEGAL_ADDRESS=""
NEXT_PUBLIC_LEGAL_VAT_ID=""
